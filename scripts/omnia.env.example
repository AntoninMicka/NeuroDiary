# SSH adresa routeru; doporučeno použít klíč a alias z ~/.ssh/config.
OMNIA_HOST=root@192.168.1.1
REMOTE_DIR=/srv/neurodiary

# Konkrétní adresy zajistí, že port nebude publikovaný na WAN rozhraní.
LAN_IP=192.168.1.1
ZEROTIER_IP=10.147.17.1
APP_PORT=8443

# docker nebo podman (musí už být na Omnii nainstalovaný).
CONTAINER_RUNTIME=podman
IMAGE_NAME=neurodiary:local
CONTAINER_NAME=neurodiary

# Pro LXC režim; pokud zůstane prázdné, deploy adresu zjistí přes lxc-info.
LXC_NAME=neurodiary
LXC_IP=
LXC_ZEROTIER_IP=
