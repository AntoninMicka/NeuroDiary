# Copy this file to scripts/cloud_run.env and adjust values before running:
#   bash scripts/cloud_run_bootstrap.sh

GCP_PROJECT_ID="your-gcp-project-id"
GCP_REGION="europe-west1"
GAR_REPOSITORY="neurodiary"
CLOUD_RUN_SERVICE="neurodiary-sync"
IMAGE_NAME="neurodiary-sync"

NEURODIARY_API_TOKEN="replace-with-long-random-token"
NEURODIARY_CORS_ORIGINS="http://localhost:5173"
NEURODIARY_DEFAULT_USER_ID="primary-user"

# Choose:
#   sqlite   = quick temporary test deploy
#   postgres = recommended for real sync
DATABASE_MODE="postgres"

# Optional Cloud Run tuning
ALLOW_UNAUTHENTICATED="true"
CLOUD_RUN_DEPLOY_FLAGS="--min-instances=0 --max-instances=3"
RUNTIME_SERVICE_ACCOUNT=""

# Optional GitHub Actions bootstrap
CREATE_GITHUB_WIF="true"
GITHUB_REPOSITORY="owner/repository"
WORKLOAD_IDENTITY_POOL_ID="github"
WORKLOAD_IDENTITY_PROVIDER_ID="neurodiary"
DEPLOY_SA_NAME="neurodiary-github-deploy"

# Required when DATABASE_MODE=postgres
POSTGRES_INSTANCE_NAME="neurodiary-db"
POSTGRES_DATABASE_NAME="neurodiary"
POSTGRES_USER="neurodiary_app"
POSTGRES_PASSWORD="replace-with-strong-db-password"

# Must match PROJECT_ID:REGION:INSTANCE_ID
CLOUD_SQL_INSTANCE="your-gcp-project-id:europe-west1:neurodiary-db"

# Optional Cloud SQL sizing
POSTGRES_TIER="db-f1-micro"
POSTGRES_STORAGE_GB="10"
POSTGRES_AVAILABILITY_TYPE="zonal"
# Optional raw flags appended to `gcloud sql instances create`
POSTGRES_INSTANCE_FLAGS=""
