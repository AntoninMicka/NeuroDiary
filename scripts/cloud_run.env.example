# Keep this example in the repository as a non-sensitive template.
# Real sensitive values are better stored in a separate file outside the repo, for example:
#   ~/.config/neurodiary/cloud_run.secrets.env
#
# You can still run the bootstrap with a project-specific config file:
#   bash scripts/cloud_run_bootstrap.sh /path/to/cloud_run.env

GCP_PROJECT_ID="your-gcp-project-id"
GCP_REGION="europe-west1"
GAR_REPOSITORY="neurodiary"
CLOUD_RUN_SERVICE="neurodiary-sync"
IMAGE_NAME="neurodiary-sync"

NEURODIARY_CORS_ORIGINS="http://localhost:5173"

# Federated auth bootstrap
ENABLE_GOOGLE_AUTH="true"
ENABLE_GMAIL_SEND="true"
ENABLE_APPLE_AUTH="false"
ENABLE_LEGACY_API_TOKEN="false"
NEURODIARY_GOOGLE_CLIENT_ID=""
NEURODIARY_APPLE_CLIENT_ID=""
NEURODIARY_APPLE_REDIRECT_PATH="/auth/apple/callback"

# Web administration. Only federated accounts in this allowlist can open it.
ENABLE_WEB_ADMIN="true"
NEURODIARY_ADMIN_EMAILS="admin@example.com"
NEURODIARY_ADMIN_ALERT_EMAIL="admin@example.com"
NEURODIARY_GMAIL_OAUTH_VERIFIED="false"
NEURODIARY_MANUAL_BACKUP_LIMIT="3"
NEURODIARY_BACKUP_RETENTION_COUNT="7"
# Security audit events are retained for two years by default (allowed range: 30-3650 days).
NEURODIARY_AUDIT_RETENTION_DAYS="730"
NEURODIARY_UPDATE_TRIGGER="neurodiary-cloud-pull"
NEURODIARY_UPDATE_SCHEDULER="neurodiary-cloud-pull"

# Sensitive values are better left out from this file and either:
# - generated automatically by the bootstrap script
# - stored in ~/.config/neurodiary/cloud_run.secrets.env
# Examples of sensitive values:
#   NEURODIARY_SESSION_SECRET
#   NEURODIARY_API_TOKEN
#   POSTGRES_PASSWORD
#   NEURODIARY_VAPID_PRIVATE_KEY
#   NEURODIARY_PUSH_SCHEDULER_TOKEN

# Web Push (optional; without all required values the capability stays disabled)
NEURODIARY_VAPID_PUBLIC_KEY=""
NEURODIARY_VAPID_SUBJECT="mailto:operations@example.com"
NEURODIARY_PUSH_ENDPOINT_HOSTS="googleapis.com,mozilla.com,apple.com,windows.com,microsoft.com"

# Choose:
#   sqlite   = quick temporary test deploy
#   postgres = recommended for real sync
DATABASE_MODE="postgres"

# Optional Cloud Run tuning
ALLOW_UNAUTHENTICATED="true"
CLOUD_RUN_DEPLOY_FLAGS="--min-instances=0 --max-instances=3"
RUNTIME_SERVICE_ACCOUNT=""

# Optional but recommended for first project setup.
# If set, the script can link the project to this billing account.
# Format: 000000-000000-000000
BILLING_ACCOUNT_ID=""

# Optional GitHub Actions bootstrap
CREATE_GITHUB_WIF="true"
CONFIGURE_GITHUB_ACTIONS="false"
TRIGGER_GITHUB_WORKFLOW="false"
GITHUB_WORKFLOW_FILE="deploy-cloud-run-backend.yml"
# Can stay empty when the local git remote `origin` points to GitHub.
GITHUB_REPOSITORY=""
WORKLOAD_IDENTITY_POOL_ID="github"
WORKLOAD_IDENTITY_PROVIDER_ID="neurodiary"
DEPLOY_SA_NAME="neurodiary-github-deploy"

# Required when DATABASE_MODE=postgres
POSTGRES_EDITION="ENTERPRISE"
POSTGRES_DATABASE_VERSION="POSTGRES_16"
POSTGRES_INSTANCE_NAME="neurodiary-db"
POSTGRES_DATABASE_NAME="neurodiary"
POSTGRES_USER="neurodiary_app"

# Must match PROJECT_ID:REGION:INSTANCE_ID
CLOUD_SQL_INSTANCE="your-gcp-project-id:europe-west1:neurodiary-db"

# Optional Cloud SQL sizing
POSTGRES_TIER="db-f1-micro"
POSTGRES_STORAGE_GB="10"
POSTGRES_AVAILABILITY_TYPE="zonal"
# Optional raw flags appended to `gcloud sql instances create`
POSTGRES_INSTANCE_FLAGS=""
