# Configuration for cloud_pull_install.sh. The Git repository must be publicly readable over HTTPS.
GCP_PROJECT_ID="your-gcp-project-id"
GCP_REGION="europe-west1"
CLOUD_RUN_SERVICE="neurodiary-sync"
GAR_REPOSITORY="neurodiary"
IMAGE_NAME="neurodiary-sync"
# Instance ID (not the full connection name). Enables a backup before every update.
CLOUD_SQL_INSTANCE="neurodiary-db"

UPDATE_GIT_REPOSITORY="https://github.com/AntoninMicka/NeuroDiary.git"
UPDATE_GIT_BRANCH="main"
# 0 disables tags; the hard maximum is 3. Tags are expected to point to release commits on the branch.
UPDATE_GIT_TAG_LIMIT="3"
UPDATE_SCHEDULE="17 3 * * *"
UPDATE_TIME_ZONE="Europe/Prague"
UPDATE_TRIGGER_NAME="neurodiary-cloud-pull"
UPDATE_SCHEDULER_JOB="neurodiary-cloud-pull"
UPDATE_SERVICE_ACCOUNT_NAME="neurodiary-cloud-updater"

# Optional output path. If omitted, the installer suggests a file in the repository root.
QR_OUTPUT_PATH=""
